msgid "Social Relay"
msgstr "انتشار اجتماعی"

msgid "Social Relay could not verify its database migration. Check database permissions and indexes, then reload an admin page."
msgstr "افزونه نتوانست به‌روزرسانی ساختار پایگاه داده را تأیید کند. سطح دسترسی و ایندکس‌های پایگاه داده را بررسی و سپس صفحهٔ مدیریت را دوباره بارگذاری کنید."

msgid "Social Relay encountered a database error. Check the database and review recent publications."
msgstr "افزونه با خطایی در پایگاه داده روبه‌رو شد. پایگاه داده و انتشارهای اخیر را بررسی کنید."

msgid "Social Relay prepares a channel update. A channel administrator copies the message, publishes it in WhatsApp, and records the publication here."
msgstr "افزونه متن پیام کانال را آماده می‌کند. مدیر کانال متن را کپی و در واتس‌اپ منتشر می‌کند و سپس انتشار را در اینجا ثبت می‌کند."

msgid "Social Relay sections"
msgstr "بخش‌های انتشار اجتماعی"

msgid "Start with a lowercase letter. Use lowercase letters, numbers, or underscores. Saving the same name for this post type replaces its mapping."
msgstr "نام را با حرف کوچک لاتین شروع کنید و فقط از حروف کوچک، عدد و زیرخط استفاده کنید. ذخیرهٔ نام تکراری برای همان نوع نوشته، نگاشت قبلی را جایگزین می‌کند."

msgid "Start with a post type and a connected destination. Add conditions when you need more control."
msgstr "از یک نوع نوشته و یک مقصد متصل شروع کنید. هر زمان به کنترل بیشتری نیاز داشتید، شرط اضافه کنید."

msgid "Status"
msgstr "وضعیت"

msgid "Submit a link post to a subreddit that permits it."
msgstr "یک پست پیوندی به ساب‌ردیتی بفرستید که این نوع انتشار را می‌پذیرد."

msgid "Subreddit"
msgstr "ساب‌ردیت"

msgid "Taxonomy slug"
msgstr "نامک طبقه‌بندی"

msgid "Template variable"
msgstr "متغیر قالب"

msgid "Template variable name"
msgstr "نام متغیر قالب"

msgid "The connection is missing or disabled."
msgstr "اتصال مقصد وجود ندارد یا غیرفعال است."

msgid "The connection secret could not be read. Replace it on the destination."
msgstr "خواندن اطلاعات محرمانهٔ اتصال ممکن نبود. آن را در مقصد جایگزین کنید."

msgid "The destination could not be reached. It will be retried."
msgstr "دسترسی به مقصد ممکن نبود. ارسال دوباره امتحان می‌شود."

msgid "The destination is temporarily unavailable. It will be retried."
msgstr "مقصد موقتاً در دسترس نیست. ارسال دوباره امتحان می‌شود."

msgid "The destination may have accepted the message. Check the destination before retrying."
msgstr "ممکن است مقصد پیام را پذیرفته باشد. پیش از تلاش دوباره، مقصد را بررسی کنید."

msgid "The destination rejected the publication. Check the connection and payload."
msgstr "مقصد انتشار را نپذیرفت. اتصال و محتوای ارسالی را بررسی کنید."

msgid "The destination requested a slower rate. It will be retried."
msgstr "مقصد درخواست کاهش سرعت ارسال کرد. ارسال دوباره امتحان می‌شود."

msgid "The destination URL is unsafe or unavailable."
msgstr "نشانی مقصد ناامن است یا در دسترس نیست."

msgid "The first publication for an enabled recipe will appear here."
msgstr "نخستین انتشار برای یک دستور فعال در اینجا نمایش داده می‌شود."

msgid "The message exceeds this provider’s text limit. Shorten the recipe template."
msgstr "پیام از سقف طول متن این شبکه بیشتر است. قالب پیام را کوتاه‌تر کنید."

msgid "The message template rendered empty."
msgstr "قالب پیام متن قابل ارسال تولید نکرد."

msgid "The numeric ID of a Page you can publish to."
msgstr "شناسهٔ عددی صفحه‌ای را وارد کنید که اجازهٔ انتشار در آن را دارید."

msgid "The post or destination is unavailable for manual publication."
msgstr "نوشته یا مقصد برای انتشار دستی در دسترس نیست."

msgid "The provider could not process the image. Check its format, dimensions and public accessibility."
msgstr "شبکه نتوانست تصویر را پردازش کند. قالب، ابعاد و دسترسی عمومی آن را بررسی کنید."

msgid "The provider is preparing the image. Check again after the next attempt."
msgstr "شبکه در حال آماده‌سازی تصویر است. پس از تلاش بعدی دوباره بررسی کنید."

msgid "The provider rejected the credentials. Check the token, its permissions and expiration."
msgstr "شبکه اطلاعات دسترسی را نپذیرفت. توکن، مجوزها و تاریخ انقضای آن را بررسی کنید."

msgid "The provider requires a single-line title. Try the {title} token on its own."
msgstr "این شبکه به عنوانی تک‌خطی نیاز دارد. از متغیر {title} به‌تنهایی استفاده کنید."

msgid "The requested job is unavailable."
msgstr "وظیفهٔ انتشار درخواستی در دسترس نیست."

msgid "The selected recipe could not be found."
msgstr "دستور انتشار انتخابی پیدا نشد."

msgid "The site URL changed. Trust this location before resuming external publication."
msgstr "نشانی سایت تغییر کرده است. پیش از ازسرگیری انتشار، نشانی جدید را تأیید کنید."

msgid "There are no enabled recipes for this post type."
msgstr "برای این نوع نوشته هیچ دستور انتشار فعالی وجود ندارد."

msgid "There are no new eligible publications for this post."
msgstr "برای این نوشته انتشار واجد شرایط تازه‌ای وجود ندارد."

msgid "This destination needs a featured image with a public HTTPS URL."
msgstr "این مقصد به تصویر شاخص با نشانی عمومی HTTPS نیاز دارد."

msgid "This destination needs a supported featured image format."
msgstr "این مقصد به تصویر شاخص با قالب پشتیبانی‌شده نیاز دارد."

msgid "This destination needs a valid post permalink."
msgstr "این مقصد به پیوند یکتای معتبر نوشته نیاز دارد."

msgid "This post is excluded."
msgstr "این نوشته از انتشار مستثنا شده است."

msgid "This recipe was edited in another session. Review the latest values before saving again."
msgstr "این دستور انتشار در جلسهٔ دیگری ویرایش شده است. پیش از ذخیرهٔ دوباره، آخرین تغییرات را بررسی کنید."

msgid "Threads access token"
msgstr "توکن دسترسی Threads"

msgid "Threads user ID"
msgstr "شناسهٔ کاربر Threads"

msgid "Trust this site location"
msgstr "تأیید نشانی این سایت"

msgid "Try a different status or destination."
msgstr "وضعیت یا مقصد دیگری را امتحان کنید."

msgid "Tumblr access token"
msgstr "توکن دسترسی Tumblr"

msgid "Unavailable"
msgstr "در دسترس نیست"

msgid "Unavailable destination"
msgstr "مقصد در دسترس نیست"

msgid "Use a member token with w_member_social or w_organization_social and the required Page role."
msgstr "از توکن کاربر دارای مجوز w_member_social استفاده کنید. برای انتشار سازمانی، توکن باید مجوز w_organization_social و نقش لازم در صفحه را داشته باشد."

msgid "Use a negative chat ID or a public @channel. Give your bot posting permissions."
msgstr "شناسهٔ منفی گفتگو یا نام عمومی کانال با پیشوند @ را وارد کنید. مجوز انتشار را به ربات بدهید."

msgid "Use a Page token with pages_manage_posts and pages_read_engagement."
msgstr "از توکن صفحه با مجوزهای pages_manage_posts و pages_read_engagement استفاده کنید."

msgid "Use a Pinterest API user token with pins:write."
msgstr "از توکن کاربر Pinterest API با مجوز pins:write استفاده کنید."

msgid "Use a public HTTPS endpoint. Redirects are disabled."
msgstr "یک نشانی عمومی HTTPS وارد کنید. تغییر مسیر دنبال نمی‌شود."

msgid "Use a secret of at least 20 characters shared with the receiver."
msgstr "از کلید محرمانه‌ای با حداقل ۲۰ نویسه استفاده کنید که با گیرنده مشترک باشد."

msgid "Use a short label that identifies this receiver."
msgstr "نام کوتاهی برای شناسایی گیرنده وارد کنید."

msgid "Use a Threads user token with threads_basic and threads_content_publish."
msgstr "از توکن کاربر Threads با مجوزهای threads_basic و threads_content_publish استفاده کنید."

msgid "Use a Tumblr OAuth 2.0 token with write access."
msgstr "از توکن OAuth 2.0 وبلاگ Tumblr با مجوز نوشتن استفاده کنید."

msgid "Use a user token with write:statuses on this instance."
msgstr "برای همین سرور از توکن کاربر با مجوز write:statuses استفاده کنید."

msgid "Use an approved Reddit API application and a user token with the submit scope."
msgstr "از برنامهٔ تأییدشدهٔ Reddit API و توکن کاربر با مجوز submit استفاده کنید."

msgid "Use an Instagram Login token with instagram_business_basic and instagram_business_content_publishing."
msgstr "از توکن Instagram Login با مجوزهای instagram_business_basic و instagram_business_content_publishing استفاده کنید."

msgid "Use an OAuth 2.0 user-context token with tweet.read, tweet.write and users.read."
msgstr "از توکن کاربر OAuth 2.0 با مجوزهای tweet.read، tweet.write و users.read استفاده کنید."

msgid "Use credentials that can publish to the selected account. Credentials are encrypted and can be replaced after setup."
msgstr "اطلاعات دسترسی را با مجوز انتشار در حساب انتخابی وارد کنید. این اطلاعات رمزگذاری می‌شود و پس از راه‌اندازی قابل جایگزینی است."

msgid "Use destination’s starter template"
msgstr "استفاده از قالب اولیهٔ مقصد"

msgid "Use the blog name, its host name, or its t: UUID."
msgstr "نام وبلاگ، نام میزبان یا شناسهٔ UUID با پیشوند t: را وارد کنید."

msgid "Use the numeric ID of a board this account can publish to."
msgstr "شناسهٔ عددی بُردی را وارد کنید که این حساب می‌تواند در آن منتشر کند."

msgid "Use the numeric professional account ID from Instagram Login."
msgstr "شناسهٔ عددی حساب حرفه‌ای را از Instagram Login وارد کنید."

msgid "Use the numeric user ID from the Threads API."
msgstr "شناسهٔ عددی کاربر را از Threads API وارد کنید."

msgid "Use the root HTTPS URL, such as https://mastodon.social."
msgstr "نشانی پایهٔ HTTPS سرور را وارد کنید. برای نمونه، ‎https://mastodon.social‎"

msgid "Use urn:li:person:… or urn:li:organization:…"
msgstr "از شناسهٔ ‎urn:li:person:…‎ یا ‎urn:li:organization:…‎ استفاده کنید."

msgid "Use values from WordPress custom fields in recipes and messages."
msgstr "از مقادیر فیلدهای سفارشی وردپرس در دستورهای انتشار و پیام‌ها استفاده کنید."

msgid "Use variables such as {title} and {url} to pull values from each post. Custom fields become available through Field mapping."
msgstr "متغیرهایی مانند {title} و {url} مقدار را از نوشته می‌خوانند. فیلدهای سفارشی از طریق بخش نگاشت فیلدها در دسترس قرار می‌گیرند."

msgid "Variables are filled from the WordPress post when the job is created."
msgstr "هنگام افزودن وظیفه به صف انتشار، متغیرها با مقادیر نوشتهٔ وردپرس پر می‌شوند."

msgid "View all"
msgstr "مشاهدهٔ همه"

msgid "View queued message"
msgstr "مشاهدهٔ پیام در صف"

msgid "Waiting to retry"
msgstr "در انتظار تلاش دوباره"

msgid "WhatsApp Channel"
msgstr "کانال واتس‌اپ"

msgid "WhatsApp channel link"
msgstr "پیوند کانال واتس‌اپ"

msgid "When a post matches an enabled recipe, its destination job appears here."
msgstr "وقتی نوشته‌ای با یک دستور فعال مطابقت داشته باشد، وظیفهٔ انتشار آن در این بخش ظاهر می‌شود."

msgid "When supplied, this rule takes precedence over the filters above. Combine conditions with all, any, or not."
msgstr "با واردکردن این قاعده، شرط‌های بالا جای خود را به آن می‌دهند. برای ترکیب شرط‌ها از all، any یا not استفاده کنید."

#, php-format
msgid "WordPress environment: %s."
msgstr "محیط وردپرس: %s"

msgid "WordPress meta key or ACF field name"
msgstr "کلید متای وردپرس یا نام فیلد ACF"

msgid "WordPress post"
msgstr "نوشتهٔ وردپرس"

msgid "WordPress posts sent here need a publicly reachable featured image."
msgstr "انتشار در این مقصد به یک تصویر شاخص با دسترسی عمومی نیاز دارد."

msgid "X user access token"
msgstr "توکن دسترسی کاربر X"

msgid "You cannot manage Social Relay."
msgstr "شما مجوز مدیریت افزونهٔ انتشار اجتماعی را ندارید."

msgid "You cannot queue this post."
msgstr "شما مجوز افزودن این نوشته به صف را ندارید."

msgid "Your activity starts here"
msgstr "انتشارهای شما در اینجا نمایش داده می‌شوند"

msgid "Your recipes"
msgstr "دستورهای انتشار شما"

